# Multi-Directory — environment template (kanban B85).
#
# Bare metal: `deploy/install.sh` writes a filled-in copy of the first block to <app>/.env.
# Docker:     copy this file to the repository root as `.env` and edit the values, then run
#             `docker compose -f deploy/docker-compose.yml up -d --build`.

# ── required ────────────────────────────────────────────────────────────────────────────────
# Postgres the directory owns. Bare metal talks to it directly; compose points at the `db` service.
DATABASE_URL=postgres://multidirectory:CHANGE_ME@127.0.0.1:5432/multi_directory
# Signs login JWTs. Any long random string:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX
# Encrypts stored provider API keys at rest (AES-256). MUST be >= 32 chars or key writes refuse:
#   openssl rand -hex 24
PROVIDER_KEY_ENC_SECRET=CHANGE_ME_AT_LEAST_32_CHARS

# ── compose-only (consumed by deploy/docker-compose.yml) ────────────────────────────────────
POSTGRES_USER=multidirectory
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=multi_directory

# ── optional ────────────────────────────────────────────────────────────────────────────────
APP_HOST=127.0.0.1          # 0.0.0.0 inside a container (the compose file sets this)
APP_PORT=8089
BASE_DOMAIN=localhost       # the host your directory answers on
ADMIN_EMAIL=admin@example.com
MD_UPLOADS_ROOT=            # defaults to ./uploads beside the binary
RUST_LOG=info
# CORESWIFT_URL / CORESWIFT_INTERNAL_KEY, EMAIL_SERVICE_URL, N8N_WEBHOOK_URL are only needed when
# those integrations are switched on; every per-tenant credential belongs in the admin panel, not here.
