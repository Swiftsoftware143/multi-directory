    var areas = (p.delivery_areas || []).join(', ') || 'All areas';
    var price = (p.price != null) ? '$' + parseFloat(p.price).toFixed(2) : 'Contact for price';
      html += '<div class="product-card" id="pc-' + p.id + '">' +
        '<h4>' + esc(p.name) + '</h4>' +
        '<div class="product-meta">' + esc(p.category || 'Uncategorized') + ' &middot; ' + esc(p.unit || 'each') + ' &middot; Min: ' + (p.min_order || 1) + '</div>' +
