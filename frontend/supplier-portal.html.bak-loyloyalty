function businessTypeLabel(bt) {
  var map = {
    'association': 'Association',
    'farm': 'Farm',
    'wholesaler': 'Wholesaler',
    'distributor': 'Distributor',
    'other': 'Other'
  };
  return map[bt] || bt;
}

async function loadDashboard() {
  var token = localStorage.getItem('supplierToken');
  if (!token) {
    $('authScreen').style.display = '';
    $('dashboard').style.display = 'none';
    return;
  }

  $('authScreen').style.display = 'none';
  $('dashboard').style.display = '';
  $('loadingState').style.display = '';
  $('dashboardContent').style.display = 'none';

  // Load notification badge count
  loadNotifBadge();

  try {
    // Try to load visitor profile
    var data = await g('/visitor/profile');
    var v = data.visitor || {};
    $('profileName').textContent = v.name || 'Supplier';
    $('profileEmail').textContent = v.email;
    var bt = v.business_type || 'supplier';
    $('profileType').textContent = businessTypeLabel(bt);
    $('profileMeta').innerHTML = '<span class="badge.primary">' + esc(businessTypeLabel(bt)) + '</span> &middot; Member since ' + (v.created_at ? new Date(v.created_at).toLocaleDateString() : 'today');
    if (v.name) {
      $('profileAvatar').textContent = v.name.charAt(0).toUpperCase();
    }

    // Update dashboard title
    $('dashboardTitle').textContent = '🏪 ' + businessTypeLabel(bt) + ' Dashboard';

    // Load supplier profile (delivery areas, min order, etc.)
    try {
      var sp = await g('/supplier/profile');
      window._supplierProfile = sp;
      // Pre-populate edit forms
      $('epName').value = sp.name || '';
      $('epEmail').value = sp.email || '';
      $('epPhone').value = sp.phone || '';
      $('epWebsite').value = sp.website || '';
      $('epDescription').value = sp.description || '';
      $('edAreas').value = (sp.delivery_areas || []).join(', ');
      $('edMinOrder').value = sp.min_order || 0;
      // Show delivery info in profile card
      var delInfo = [];
      if (sp.delivery_areas && sp.delivery_areas.length > 0) delInfo.push('🚚 ' + sp.delivery_areas.join(', '));
      if (sp.min_order > 0) delInfo.push('Min. Order: $' + sp.min_order);
      $('profileDelivery').textContent = delInfo.join(' · ');
    } catch(e) {
      // Supplier profile may not be linked yet - that's ok
      console.log('Supplier profile not yet available:', e.message);
    }

    // Load my products
    loadMyProducts();

    // Load connected services status
    loadSupplierConnectedServices();

    // Try to fetch product count (public endpoint)
    try {
      var prodData = await g('/b2b/products?per_page=1');
      $('productCount').textContent = (prodData.total || 0);
    } catch(e) {
      $('productCount').textContent = '-';
    }

    $('loadingState').style.display = 'none';
    $('dashboardContent').style.display = '';
    
    // Load loyalty data
    loadDistributorLoyalty();

    // Load order stats
    loadSupplierStats();
  } catch(e) {
    // Token expired or invalid
    doLogout();
  }
}

// ── Distributor Loyalty ──
function loadDistributorLoyalty() {
  var tok = localStorage.getItem('supplierToken');
  if (!tok) return;
  var h = { 'Authorization': 'Bearer ' + tok };
  fetch('/api/v1/loyalty/portal/dashboard', { headers: h })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var cEl = document.getElementById('distCredits');
      var vEl = document.getElementById('distVouchers');
      var rEl = document.getElementById('distReferrals');
      var cdEl = document.getElementById('distCode');
      if (cEl) cEl.textContent = '$' + (d.total_credits || 0);
      if (vEl) vEl.textContent = d.active_vouchers || 0;
      if (rEl) rEl.textContent = d.referral_count || 0;
      if (cdEl) {
        cdEl.textContent = d.referrer_code || 'No code';
        cdEl.style.cursor = 'pointer';
        cdEl.onclick = function() {
          if (d.referrer_code) {
            if (navigator.clipboard) {
              navigator.clipboard.writeText(d.referrer_code).then(function() {
                toast('📋 Copied referral code!', 'success');
              }).catch(function() { /* ignore */ });
            }
          }
        };
      }
    })
    .catch(function() {
      // Show enrollment CTA if loyalty dashboard fails (no IS account)
      var cta = document.getElementById('loyaltyEnrollCTA');
      if (cta) cta.style.display = '';
    });
}

// ── Loyalty Enrollment ──
function enrollInLoyalty() {
  var btn = document.getElementById('enrollLoyaltyBtn');
  var status = document.getElementById('enrollStatus');
  var token = localStorage.getItem('supplierToken');
  if (!token) { status.textContent = '⚠️ Not logged in'; status.style.display = ''; return; }
  btn.disabled = true;
  btn.textContent = '⏳ Enrolling...';
  status.style.display = '';
  status.textContent = 'Getting you set up with ZaarHub B2B Loop...';
  status.style.color = '#fff';

  fetch('/api/v1/loyalty/enroll', {
    method: 'POST',
    headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
    body: '{}'
  })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (d.success) {
        status.textContent = '✅ ' + d.message + ' — reloading...';
        var cta = document.getElementById('loyaltyEnrollCTA');
        if (cta) cta.style.display = 'none';
        // Reload loyalty data
        setTimeout(function() { loadDistributorLoyalty(); }, 1500);
      } else {
        status.textContent = '❌ ' + (d.message || 'Enrollment failed');
        status.style.color = '#ffe0e0';
        btn.disabled = false;
        btn.textContent = '🚀 Enroll Now';
      }
    })
    .catch(function(e) {
      status.textContent = '❌ Network error: ' + e.message;
      status.style.color = '#ffe0e0';
      btn.disabled = false;
      btn.textContent = '🚀 Enroll Now — Free';
    });
}

