function confirmDeleteProduct(id, name) {
  var dialog = document.createElement('div');
  dialog.className = 'confirm-dialog';
  dialog.id = 'deleteDialog';
  dialog.innerHTML = '<div class="dialog-card"><h3>🗑️ Delete Product</h3><p>Are you sure you want to delete <strong>' + esc(name) + '</strong>? This cannot be undone.</p><div class="dialog-actions"><button class="btn btn-secondary" onclick="document.getElementById(\'deleteDialog\').remove()">Cancel</button><button class="btn btn-primary" style="background:var(--danger)" onclick="deleteProduct(\'' + id + '\')">Delete</button></div></div>';
  document.body.appendChild(dialog);
  dialog.onclick = function(e) { if (e.target === dialog) dialog.remove(); };
}

async function deleteProduct(id) {
  try {
    await del('/b2b/products/' + id);
    toast('Product deleted', 'success');
    var dialog = document.getElementById('deleteDialog');
    if (dialog) dialog.remove();
    loadMyProducts();
  } catch(e) {
    toast('Failed to delete: ' + e.message, 'error');
  }
}

// ── CSV Import/Export ──

async function exportProductsCSV() {
  try {
    var resp = await fetch('/api/v1/b2b/products/export', {
      headers: { 'Authorization': 'Bearer ' + (localStorage.getItem('supplierToken') || '') }
    });
    if (!resp.ok) {
      var err = await resp.json().catch(function(){ return {message:'Export failed'}; });
      toast('Export failed: ' + (err.message || 'HTTP ' + resp.status), 'error');
      return;
    }
    var blob = await resp.blob();
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'products.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    toast('Products exported successfully!', 'success');
  } catch(e) {
    toast('Export failed: ' + e.message, 'error');
  }
}

function importProductsCSV(input) {
  var file = input.files[0];
  if (!file) return;
  
  var results = document.getElementById('importResults');
  results.style.display = 'block';
  results.innerHTML = '<p>⏳ Importing <strong>' + esc(file.name) + '</strong>...</p>';

  var formData = new FormData();
  formData.append('file', file);

  fetch('/api/v1/b2b/products/import', {
    method: 'POST',
    headers: { 'Authorization': 'Bearer ' + (localStorage.getItem('supplierToken') || '') },
    body: formData
  })
  .then(function(resp) { return resp.json(); })
  .then(function(data) {
    var html = '<h4>' + (data.error ? '❌ Import Failed' : '✅ Import Complete') + '</h4>';
    html += '<p>📦 Imported: <strong>' + (data.imported || 0) + '</strong> | ⏭️ Skipped: <strong>' + (data.skipped || 0) + '</strong></p>';
    if (data.errors && data.errors.length > 0) {
      html += '<div style="margin-top:8px;max-height:200px;overflow-y:auto;background:var(--bg);padding:8px;border-radius:4px;font-size:13px">';
      html += '<strong style="color:var(--danger)">Errors (' + data.errors.length + '):</strong><ul style="margin:4px 0 0 16px">';
      for (var i = 0; i < data.errors.length; i++) {
        html += '<li>' + esc(data.errors[i]) + '</li>';
      }
      html += '</ul></div>';
    }
    results.innerHTML = html;
    loadMyProducts();
  })
  .catch(function(e) {
    results.innerHTML = '<p style="color:var(--danger)">❌ Import failed: ' + esc(e.message) + '</p>';
  })
  .finally(function() {
    // Reset file input so the same file can be re-uploaded
    input.value = '';
  });
}

// ── Dashboard Tab Switching ──
function switchDashTab(tab) {
  document.querySelectorAll('#dashTabs .tab').forEach(function(t){ t.classList.remove('active'); });
  document.getElementById('dtab-'+tab).classList.add('active');
  ['overview','orders','messages'].forEach(function(t){
    var el = document.getElementById('tab-'+t);
    if (el) el.style.display = (t === tab) ? '' : 'none';
  });
  if (tab === 'orders') { loadOrders(); }
  if (tab === 'messages') { loadMessages(); }
}

// ── Orders ──
function statusBadge(s) {
  var colors = { pending:'#f59e0b', confirmed:'#3b82f6', shipped:'#8b5cf6', delivered:'#22c55e', cancelled:'#ef4444' };
  var c = colors[s] || '#6b7280';
  var bg = ({
    pending:'#fef3c7', confirmed:'#dbeafe', shipped:'#ede9fe', delivered:'#dcfce7', cancelled:'#fee2e2'
  })[s] || '#f3f4f6';
  return '<span style="display:inline-block;padding:2px 8px;border-radius:4px;font-size:.75rem;font-weight:600;color:'+c+';background:'+bg+'">'+esc(s)+'</span>';
}


// Detect order role from business_type
function detectOrderRole(){
  var infoStr = localStorage.getItem('distributorInfo');
  var info = infoStr ? JSON.parse(infoStr) : null;
  var bt = (info && info.business_type) ? info.business_type : '';
  var isSupplier = ['supplier','distributor','wholesaler','manufacturer'].indexOf(bt) >= 0;
  var isBuyer = ['buyer','retailer','business','customer'].indexOf(bt) >= 0;
  if(info && info.business_type === undefined && info.account_type === 'business') isBuyer = true;
  return isSupplier ? 'supplier' : (isBuyer ? 'buyer' : 'both');
}

// Current toggle for the order view (overrides auto-detection)
var _orderViewOverride = null;

async function loadOrders() {
  var container = document.getElementById('ordersList');
  if (!container) return;
  container.innerHTML = '<div style="text-align:center;padding:20px"><div class="spinner"></div></div>';
  try {
    var status = document.getElementById('orderStatusFilter');
    var role = _orderViewOverride || detectOrderRole();
    var qs = '?role=' + role;
    if (status && status.value) qs += '&status=' + encodeURIComponent(status.value);
    var data = await g('/b2b/orders' + qs);
    var orders = data.orders || [];
    
    // Build toggle bar
    var detected = detectOrderRole();
    var toggleHtml = '<div style="display:flex;gap:8px;align-items:center;margin-bottom:12px;flex-wrap:wrap">';
    toggleHtml += '<span style="font-size:.8rem;color:var(--text-secondary);margin-right:4px">View:</span>';
    var views = [
      {label:'📤 Selling', role:'supplier'},
      {label:'📥 Buying', role:'buyer'},
      {label:'🔄 All', role:'both'}
    ];
    views.forEach(function(v){
      var active = (role === v.role);
      toggleHtml += '<button class="btn '+(active?'btn-primary':'btn-secondary')+'" style="font-size:.75rem;padding:4px 10px" onclick="_orderViewOverride=\''+v.role+'\';loadOrders()">'+v.label+(v.role===detected&&!_orderViewOverride?' (default)':'')+'</button>';
    });
    if(_orderViewOverride){
      toggleHtml += '<button class="btn btn-secondary" style="font-size:.75rem;padding:4px 8px" onclick="_orderViewOverride=null;loadOrders()">Reset to default</button>';
    }
    toggleHtml += '</div>';
    
    if (orders.length === 0) {
      var viewLabel = role==='supplier'?'selling':'buying';
      container.innerHTML = toggleHtml + '<div class="empty-state"><div class="icon">📋</div><h3>No '+viewLabel+' orders yet</h3><p>Orders will appear here when you '+viewLabel+' products on the marketplace.</p></div>';
      return;
    }
    var html = toggleHtml;
    html += '<div style="overflow-x:auto"><table style="width:100%;border-collapse:collapse;font-size:.85rem">';
    html += '<thead><tr style="border-bottom:2px solid var(--border);text-align:left">';
    ['Order','Product','Buyer','Qty','Total','Status','Date','Actions'].forEach(function(h){
      html += '<th style="padding:8px;color:var(--text-secondary);font-weight:600">'+h+'</th>';
    });
    html += '</tr></thead><tbody>';
    orders.forEach(function(o){
      var shortId = (o.id || '').substring(0,8);
      var date = o.created_at ? new Date(o.created_at).toLocaleDateString() : '-';
      var price = o.total_amount ? '$'+parseFloat(o.total_amount).toFixed(2) : '-';
      var acts = '';
      if (o.status === 'pending') {
        acts += '<button class="btn btn-secondary" style="font-size:.75rem;padding:4px 8px" onclick="updateOrderStatus(\''+o.id+'\',\'confirmed\')">\u2705 Confirm</button> ';
        acts += '<button class="btn btn-secondary" style="font-size:.75rem;padding:4px 8px;color:var(--danger)" onclick="updateOrderStatus(\''+o.id+'\',\'cancelled\')">\u274c Cancel</button>';
      } else if (o.status === 'confirmed') {
        acts += '<button class="btn btn-secondary" style="font-size:.75rem;padding:4px 8px" onclick="showFulfillModal(\''+o.id+'\')">📝 Fulfill</button> ';
        acts += '<button class="btn btn-secondary" style="font-size:.75rem;padding:4px 8px" onclick="updateOrderStatus(\''+o.id+'\',\'shipped\')">🚚 Ship</button> ';
        acts += '<button class="btn btn-secondary" style="font-size:.75rem;padding:4px 8px;color:var(--danger)" onclick="updateOrderStatus(\''+o.id+'\',\'cancelled\')">\u274c Cancel</button>';
      } else if (o.status === 'shipped') {
        acts += '<button class="btn btn-secondary" style="font-size:.75rem;padding:4px 8px" onclick="showFulfillModal(\''+o.id+'\')">📝 Fulfill</button> ';
        acts += '<button class="btn btn-secondary" style="font-size:.75rem;padding:4px 8px" onclick="updateOrderStatus(\''+o.id+'\',\'delivered\')">📦 Delivered</button>';
      } else if (o.status === 'delivered') {
        acts += '<button class="btn btn-secondary" style="font-size:.75rem;padding:4px 8px" onclick="showReviewModal(\''+o.id+'\')">⭐ Review</button>';
      }
      html += '<tr style="border-bottom:1px solid var(--border)">';
      html += '<td style="padding:8px;font-family:monospace;font-size:.75rem">#'+esc(shortId)+'</td>';
      html += '<td style="padding:8px">'+esc(o.product_name || 'Product')+'</td>';
      html += '<td style="padding:8px">'+esc(o.buyer_name || 'Buyer')+'</td>';
      html += '<td style="padding:8px">'+(o.quantity || 1)+'</td>';
      html += '<td style="padding:8px;font-weight:600">'+price+'</td>';
      html += '<td style="padding:8px">'+statusBadge(o.status)+'</td>';
      html += '<td style="padding:8px;font-size:.8rem;color:var(--text-secondary)">'+date+'</td>';
      html += '<td style="padding:8px">'+acts+'</td>';
      html += '</tr>';
    });
    html += '</tbody></table></div>';
    html += '<p style="margin-top:8px;font-size:.8rem;color:var(--text-secondary)">'+orders.length+' / '+data.total+' orders</p>';
    container.innerHTML = html;
  } catch(e) {
    container.innerHTML = '<div class="empty-state"><div class="icon">⚠️</div><h3>Error</h3><p>'+esc(e.message)+'</p></div>';
  }
}

async function updateOrderStatus(id, status) {
  try {
    await pu('/b2b/orders/'+id+'/status', { status: status });
    toast('Order ' + status + '!', 'success');
    loadOrders();
    loadSupplierStats();
  } catch(e) {
    toast('Failed: ' + e.message, 'error');
  }
}

// ── Supplier Stats ──
async function loadSupplierStats() {
  try {
    var data = await g('/supplier/stats');
    $('statTotalOrders').textContent = data.total_orders || 0;
    $('statPendingOrders').textContent = data.pending_orders || 0;
    $('statConfirmedOrders').textContent = data.confirmed_orders || 0;
    $('statShippedOrders').textContent = data.shipped_orders || 0;
    $('statDeliveredOrders').textContent = data.delivered_orders || 0;
    $('statCancelledOrders').textContent = data.cancelled_orders || 0;
    var rev = parseFloat(data.total_revenue) || 0;
    $('statTotalRevenue').textContent = '$' + rev.toFixed(2);
    var avg = parseFloat(data.avg_rating) || 0;
    $('statAvgRating').textContent = avg > 0 ? avg.toFixed(1) + ' ⭐' : '-';
    var section = $('supplierOrderStatsSection');
    if (section) section.style.display = '';
  } catch(e) {
    // Stats not available — keep section hidden
    console.log('Stats not available:', e.message);
  }
}

// ── Fulfill Order ──
var _fulfillOrderId = null;
function showFulfillModal(orderId) {
  _fulfillOrderId = orderId;
  $('fulfillTrackingNumber').value = '';
  $('fulfillCarrier').value = '';
  $('fulfillEstDelivery').value = '';
  $('fulfillModal').style.display = 'flex';
}

async function submitFulfill() {
  var id = _fulfillOrderId;
  if (!id) return;
  var body = {};
  var tn = $('fulfillTrackingNumber').value.trim();
  if (tn) body.tracking_number = tn;
  var carrier = $('fulfillCarrier').value.trim();
  if (carrier) body.carrier = carrier;
  var est = $('fulfillEstDelivery').value;
  if (est) body.estimated_delivery = est;
  try {
    await pu('/b2b/orders/' + id + '/fulfill', body);
    toast('Order fulfilled!', 'success');
    $('fulfillModal').style.display = 'none';
    loadOrders();
  } catch(e) {
    toast('Failed: ' + e.message, 'error');
  }
}

// ── Review Buyer ──
var _reviewOrderId = null;
var _reviewRating = 0;

function setStarRating(r) {
  _reviewRating = r;
  for (var i = 1; i <= 5; i++) {
    var el = $('star' + i);
    if (el) el.textContent = i <= r ? '★' : '☆';
  }
}

function showReviewModal(orderId) {
  _reviewOrderId = orderId;
  _reviewRating = 0;
  $('reviewText').value = '';
  // Reset stars
  for (var i = 1; i <= 5; i++) {
    var el = $('star' + i);
    if (el) el.textContent = '☆';
  }
  $('reviewModal').style.display = 'flex';
}

async function submitReview() {
  var id = _reviewOrderId;
  if (!id) return;
  if (_reviewRating < 1 || _reviewRating > 5) {
    toast('Please select a rating (1-5 stars)', 'error');
    return;
  }
  var body = { rating: _reviewRating };
  var txt = $('reviewText').value.trim();
  if (txt) body.review = txt;
  try {
    await po('/b2b/orders/' + id + '/review', body);
    toast('Review submitted!', 'success');
    $('reviewModal').style.display = 'none';
    loadOrders();
    loadSupplierStats();
  } catch(e) {
    toast('Failed: ' + e.message, 'error');
  }
}

// ── Messages ──
function toggleComposeMessage() {
  var form = document.getElementById('composeMsgForm');
  form.classList.toggle('show');
  if (form.classList.contains('show')) {
    document.getElementById('msgToBusinessId').value = '';
    document.getElementById('msgSubject').value = '';
    document.getElementById('msgBody').value = '';
  }
}

async function sendMessage() {
  var toId = document.getElementById('msgToBusinessId').value.trim();
  var subject = document.getElementById('msgSubject').value.trim();
  var body = document.getElementById('msgBody').value.trim();
  if (!toId || !subject || !body) { toast('All fields required', 'error'); return; }
  try {
    await po('/b2b/messages', { to_business_id: toId, subject: subject, message: body });
    toast('Message sent!', 'success');
    document.getElementById('composeMsgForm').classList.remove('show');
    loadMessages();
  } catch(e) {
    toast('Failed: ' + e.message, 'error');
  }
}

async function loadMessages() {
  var container = document.getElementById('messagesList');
  if (!container) return;
  container.innerHTML = '<div style="text-align:center;padding:20px"><div class="spinner"></div></div>';
  try {
    var data = await g('/b2b/messages');
    var msgs = data.messages || [];
    if (msgs.length === 0) {
      container.innerHTML = '<div class="empty-state"><div class="icon">💬</div><h3>No messages</h3><p>When businesses message you, they will appear here.</p></div>';
      return;
    }
    var html = '';
    msgs.forEach(function(m){
      var date = m.created_at ? new Date(m.created_at).toLocaleDateString() : '-';
      var unreadClass = m.is_read ? '' : ' style="font-weight:700;background:#fef3e7"';
      html += '<div'+unreadClass+' class="link-card" onclick="viewMessage(\''+m.id+'\')" style="cursor:pointer">';
      html += '<div style="display:flex;justify-content:space-between;align-items:center">';
      html += '<h4 style="margin:0">'+esc(m.subject || '(no subject)')+'</h4>';
      html += (m.is_read ? '<span class="badge" style="background:#f1f5f9;color:#64748b">Read</span>' : '<span class="badge" style="background:#fef3c7;color:#f59e0b">New</span>');
      html += '</div>';
      html += '<p style="margin:4px 0 0;font-size:.8rem;color:var(--text-secondary)">From: '+esc(m.sender_name || m.sender_email || 'Unknown')+' &middot; '+date+'</p>';
      html += '</div>';
    });
    html += '<p style="margin-top:8px;font-size:.8rem;color:var(--text-secondary)">'+msgs.length+' / '+data.total+' messages</p>';
    container.innerHTML = html;
  } catch(e) {
    container.innerHTML = '<div class="empty-state"><div class="icon">⚠️</div><h3>Error</h3><p>'+esc(e.message)+'</p></div>';
  }
}

var _currentMsgId = null;

async function viewMessage(id) {
  // Fetch individual message isn't a direct API, but we can mark it read and show detail from the list
  // For simplicity, use the list data to show detail
  try {
    var data = await g('/b2b/messages');
    var msgs = data.messages || [];
    var m = null;
    for (var i = 0; i < msgs.length; i++) { if (msgs[i].id === id) { m = msgs[i]; break; } }
    if (!m) { toast('Message not found', 'error'); return; }
    _currentMsgId = id;
    document.getElementById('msgDetailSubject').textContent = m.subject || '(no subject)';
    document.getElementById('msgDetailSender').textContent = m.sender_name || m.sender_email || 'Unknown';
    document.getElementById('msgDetailDate').textContent = m.created_at ? new Date(m.created_at).toLocaleString() : '-';
    document.getElementById('msgDetailBody').textContent = m.message || '';
    var st = document.getElementById('msgDetailStatus');
    if (m.is_read) { st.textContent = 'Read'; st.className = 'badge'; st.style.background = '#f1f5f9'; st.style.color = '#64748b'; }
    else { st.textContent = 'New'; st.className = 'badge'; st.style.background = '#fef3c7'; st.style.color = '#f59e0b'; }
    var mb = document.getElementById('msgDetailMarkRead');
    mb.style.display = m.is_read ? 'none' : '';
    document.getElementById('msgDetailModal').style.display = 'flex';
  } catch(e) {
    toast('Error: ' + e.message, 'error');
  }
}

async function markMsgReadFromDetail() {
  if (!_currentMsgId) return;
  try {
    await pu('/b2b/messages/' + _currentMsgId + '/read', {});
    toast('Marked as read', 'success');
    document.getElementById('msgDetailModal').style.display = 'none';
    loadMessages();
  } catch(e) {
    toast('Failed: ' + e.message, 'error');
  }
}

