async function doRegister() {
  var name = $('regName').value.trim() || undefined;
  var email = $('regEmail').value.trim();
  var password = $('regPassword').value;
  var phone = $('regPhone').value.trim() || undefined;
  var businessType = $('regBusinessType').value;

