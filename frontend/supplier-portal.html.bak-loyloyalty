          '<div class="form-group"><label>Name</label><input type="text" id="iename-' + p.id + '" value="' + esc(p.name).replace(/"/g, '&quot;') + '"></div>' +
          '<div class="form-group"><label>Description</label><textarea id="iedesc-' + p.id + '">' + esc(p.description || '') + '</textarea></div>' +
          '<div class="form-group"><label>Category</label><input type="text" id="iecat-' + p.id + '" value="' + esc(p.category || '') + '"></div>' +
          '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">' +
            '<div class="form-group"><label>Price</label><input type="number" id="ieprice-' + p.id + '" value="' + (p.price || '') + '" step="0.01"></div>' +
            '<div class="form-group"><label>Unit</label><input type="text" id="ieunit-' + p.id + '" value="' + esc(p.unit || '') + '"></div>' +
          '</div>' +
          '<div class="form-group"><label>Min Order</label><input type="number" id="iemin-' + p.id + '" value="' + (p.min_order || 1) + '" min="1"></div>' +
          '<div class="form-group"><label>Delivery Areas</label><textarea id="ieareas-' + p.id + '">' + esc((p.delivery_areas || []).join(', ')) + '</textarea></div>' +
          '<div class="form-actions">' +
            '<button class="btn btn-secondary" onclick="toggleEditProduct(\'' + p.id + '\')">Cancel</button>' +
            '<button class="btn btn-primary" onclick="saveEditProduct(\'' + p.id + '\')">💾 Save</button>' +
          '</div>' +
        '</div>' +
      '</div>';
  }
  html += '</div>';
  container.innerHTML = html;
}

function toggleEditProduct(id) {
  var ie = document.getElementById('ie-' + id);
  if (!ie) return;
  var showing = ie.classList.contains('show');
  // Close all open inline edits first
  var all = document.querySelectorAll('.inline-edit.show');
  for (var i = 0; i < all.length; i++) { all[i].classList.remove('show'); }
  if (!showing) { ie.classList.add('show'); }
}

async function saveNewProduct() {
  var name = $('apName').value.trim();
  if (!name) { toast('Product name is required', 'error'); return; }
  var areasRaw = $('apDeliveryAreas').value.trim();
  var areas = areasRaw ? areasRaw.split(',').map(function(s){ return s.trim(); }).filter(function(s){ return s.length > 0; }) : [];
  var body = {
    name: name,
    description: $('apDescription').value.trim() || undefined,
    category: $('apCategory').value.trim() || undefined,
    price: $('apPrice').value ? parseFloat($('apPrice').value) : undefined,
    unit: $('apUnit').value.trim() || undefined,
    min_order: parseInt($('apMinOrder').value) || 1,
    delivery_areas: areas.length > 0 ? areas : undefined
  };
  try {
    await po('/b2b/products', body);
    toast('Product added!', 'success');
    $('addProductForm').classList.remove('show');
    loadMyProducts();
  } catch(e) {
    toast('Failed to add product: ' + e.message, 'error');
  }
}

