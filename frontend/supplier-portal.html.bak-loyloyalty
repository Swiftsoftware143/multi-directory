          '<button class="btn btn-secondary" style="color:var(--danger);border-color:var(--danger)" onclick="confirmDeleteProduct(\'' + p.id + '\',\'' + esc(p.name).replace(/'/g, "\\'") + '\')">🗑️ Delete</button>' +
        '</div>' +
