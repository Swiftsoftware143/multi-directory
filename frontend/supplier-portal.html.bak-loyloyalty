async function loadSupplierConnectedServices() {
  try {
    var r = await fetch('/api/v1/connected-services', { headers: authHeaders() });
    if (!r.ok) return;
    var data = await r.json();
    renderSupplierConnectedStatus(data);
  } catch(e) { console.error('Connected services:', e); }
}

function renderSupplierConnectedStatus(data) {
  var isEl = document.getElementById('supplierIsStatus');
  var csEl = document.getElementById('supplierCsStatus');
  
  if (isEl && data.incentiveswift) {
    if (data.incentiveswift.connected) {
      isEl.innerHTML = '<span style="font-size:.82rem;color:var(--success);font-weight:600">✅ Connected</span>' +
        ' <button class="btn btn-sm btn-danger" onclick="disconnectSupplierService(\'incentiveswift\')" style="font-size:.75rem;padding:4px 10px">Disconnect</button>';
    } else {
      isEl.innerHTML = '<button class="btn btn-sm btn-primary" onclick="showSupplierConnectForm(\'incentiveswift\')">Connect</button>';
    }
  }
  
  if (csEl && data.coreswift) {
    if (data.coreswift.connected) {
      csEl.innerHTML = '<span style="font-size:.82rem;color:var(--success);font-weight:600">✅ Connected</span>' +
        ' <button class="btn btn-sm btn-danger" onclick="disconnectSupplierService(\'coreswift\')" style="font-size:.75rem;padding:4px 10px">Disconnect</button>';
    } else {
      csEl.innerHTML = '<button class="btn btn-sm btn-primary" onclick="supplierConnectCoreSwift()">Connect</button>';
    }
  }
}

function showSupplierConnectForm(service) {
  if (service === 'incentiveswift') {
    document.getElementById('supplierIsConnectForm').style.display = '';
  }
}

async function supplierConnectIS() {
  var tenantId = document.getElementById('supplierIsTenantId').value.trim();
  var apiKey = document.getElementById('supplierIsApiKey').value.trim();
  if (!tenantId || !apiKey) {
    document.getElementById('supplierIsConnectResult').textContent = '❌ Tenant ID and API key required';
    return;
  }
  try {
    var r = await fetch('/api/v1/connected-services/incentiveswift', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', ...authHeaders() },
      body: JSON.stringify({ tenant_id: tenantId, api_key: apiKey })
    });
    if (!r.ok) throw new Error((await r.json()).message || 'Connection failed');
    document.getElementById('supplierIsConnectForm').style.display = 'none';
    loadSupplierConnectedServices();
  } catch(e) {
    document.getElementById('supplierIsConnectResult').textContent = '❌ ' + e.message;
  }
}

async function supplierConnectCoreSwift() {
  try {
    var r = await fetch('/api/v1/connected-services/coreswift', {
      method: 'POST',
      headers: authHeaders()
    });
    if (!r.ok) throw new Error((await r.json()).message || 'Connection failed');
    loadSupplierConnectedServices();
  } catch(e) {
    toast('❌ ' + e.message, 'error');
  }
}

async function disconnectSupplierService(service) {
  if (!confirm('Disconnect ' + service + '? Your listing features will be affected.')) return;
  try {
    var r = await fetch('/api/v1/connected-services/' + service, { method: 'DELETE', headers: authHeaders() });
    if (!r.ok) throw new Error('Failed to disconnect');
    loadSupplierConnectedServices();
  } catch(e) {
    toast('❌ ' + e.message, 'error');
  }
}

